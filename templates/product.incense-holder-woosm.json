      ],
      "name": "SS - Text Block #2",
      "settings": {
        "content_horizontal_align": "center",
        "content_horizontal_align_mobile": "center",
        "heading": "<h2>A Light and an Incense Holder</h2>",
        "heading_custom": false,
        "heading_font": "serif",
        "heading_size": 20,
        "heading_size_mobile": 14,
        "heading_height": 110,
        "text": "<p><a href=\"#\" target=\"_blank\" title=\"#\">Handmade</a> in South Korea, this sculptural object combines an <a href=\"#\" target=\"_blank\" title=\"#\">ambient light</a> with a <a href=\"#\" target=\"_blank\" title=\"#\">brass incense holder</a> designed for <a href=\"#\" target=\"_blank\" title=\"#\">many types of incense</a>. Place it on an <a href=\"#\" target=\"_blank\" title=\"#\">entry table</a>, beside a favorite chair, at <a href=\"#\" target=\"_blank\" title=\"#\">dinner with friends</a>, or anywhere a <a href=\"#\" target=\"_blank\" title=\"#\">small source of light</a> can make a space feel warmer.</p>",
