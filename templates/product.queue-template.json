            "custom_liquid_EqMCqa": {
              "type": "custom-liquid",
              "name": "Sigaretta alternative",
              "settings": {
                "custom_liquid": "{% if product.id == 7729193648306 %}\n  {% assign alternative = all_products['tsubota-pearl-sigaretta-stick-lighter'] %}\n  {% if alternative.available %}\n    <lp-queue-alternative hidden data-initial-variant=\"{{ product.selected_or_first_available_variant.id }}\">\n      <script type=\"application/json\" data-queue-variants>{{ product.variants | json }}</script>\n      {% for variant in alternative.variants %}\n        {% if variant.available %}\n          {% assign card_image = variant.featured_image | default: alternative.featured_image %}\n          <div class=\"lp-alternative-card\" data-alternative-color=\"{{ variant.title | escape }}\" hidden>\n            {% if card_image %}\n              {{ card_image | image_url: width: 240 | image_tag: class: 'lp-alternative-image', loading: 'lazy', alt: card_image.alt }}\n            {% endif %}\n            <div class=\"lp-alternative-content\">\n              <p class=\"lp-alternative-heading\">Your color sold out?</p>\n              <p class=\"lp-alternative-copy\">Meet Sigaretta, a rounded take on the Queue from Tsubota Pearl.</p>\n              <p class=\"lp-alternative-stock\">{{ variant.title | escape }} available · {{ variant.price | money }}</p>\n              <a class=\"lp-alternative-link\" href=\"{{ variant.url }}\" data-color-link=\"{{ variant.url }}\" data-product-link=\"{{ alternative.url }}\">Shop Sigaretta <span aria-hidden=\"true\">→</span></a>\n            </div>\n          </div>\n        {% endif %}\n      {% endfor %}\n    </lp-queue-alternative>\n    <style>\n      lp-queue-alternative { display: block; width: 100%; }\n      lp-queue-alternative[hidden], lp-queue-alternative [hidden] { display: none !important; }\n      .lp-alternative-card { display: grid; grid-template-columns: 80px minmax(0, 1fr); gap: 16px; align-items: center; padding: 16px; border: 1px solid currentColor; border-color: color-mix(in srgb, currentColor 20%, transparent); border-radius: 4px; }\n      .lp-alternative-image { display: block; width: 80px; height: 100px; object-fit: cover; border-radius: 2px; }\n      .lp-alternative-content { min-width: 0; }\n      .lp-alternative-heading { margin: 0 0 6px; font-weight: 600; font-size: 15px; line-height: 1.35; }\n      .lp-alternative-copy, .lp-alternative-stock { margin: 0 0 8px; font-size: 13px; line-height: 1.5; }\n      .lp-alternative-stock { font-size: 12px; }\n      .lp-alternative-link { display: inline-block; padding: 6px 0; color: inherit; font-size: 13px; font-weight: 600; text-decoration: underline; text-underline-offset: 4px; }\n      .lp-alternative-link:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }\n      @media (max-width: 380px) { .lp-alternative-card { grid-template-columns: 64px minmax(0, 1fr); gap: 12px; padding: 12px; } .lp-alternative-image { width: 64px; height: 88px; } }\n    </style>\n    <script>\n      if (!customElements.get('lp-queue-alternative')) {\n        customElements.define('lp-queue-alternative', class extends HTMLElement {\n          connectedCallback() {\n            queueMicrotask(() => {\n              if (!this.isConnected || this.controller) return;\n              this.variants = JSON.parse(this.querySelector('[data-queue-variants]').textContent);\n              this.root = this.closest('.shopify-section');\n              if (!this.root) return;\n              this.controller = new AbortController();\n              const refresh = () => this.refresh();\n              this.root.addEventListener('change', refresh, { signal: this.controller.signal });\n              window.addEventListener('popstate', refresh, { signal: this.controller.signal });\n              this.observer = new MutationObserver(records => {\n                if (records.some(record => !this.contains(record.target))) this.refresh();\n              });\n              this.observer.observe(this.root, { childList: true, subtree: true, attributes: true, attributeFilter: ['value', 'checked', 'data-current-checked'] });\n              this.refresh();\n            });\n          }\n          disconnectedCallback() {\n            this.controller?.abort();\n            this.observer?.disconnect();\n            this.controller = null;\n          }\n          refresh() {\n            const selected = this.root.querySelector('input[type=\"radio\"][data-variant-id]:checked');\n            const id = selected?.dataset.variantId || this.root.querySelector('input[name=\"id\"]')?.value || this.dataset.initialVariant;\n            const queueVariant = this.variants.find(variant => String(variant.id) === String(id));\n            const cards = Array.from(this.querySelectorAll('[data-alternative-color]'));\n            const match = cards.find(card => card.dataset.alternativeColor.toLowerCase() === queueVariant?.title.toLowerCase());\n            const active = match || cards[0];\n            const show = Boolean(queueVariant && !queueVariant.available && active);\n            cards.forEach(card => { card.hidden = !show || card !== active; });\n            if (active) {\n              const link = active.querySelector('a');\n              link.setAttribute('href', match ? link.dataset.colorLink : link.dataset.productLink);\n            }\n            this.hidden = !show;\n          }\n        });\n      }\n    </script>\n  {% endif %}\n{% endif %}"
