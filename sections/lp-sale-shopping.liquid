<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div class="section section--page-width color-{{ section.settings.color_scheme }} lp-sale-shop" style="--lp-sale-columns: {{ section.settings.columns }}; --lp-sale-mobile-columns: {{ section.settings.mobile_columns }}; --lp-sale-gap: {{ section.settings.gap }}px; --lp-sale-top: {{ section.settings.padding_top }}px; --lp-sale-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="lp-sale-shop__inner">
    {% if section.settings.heading != blank %}
      <h2 class="lp-sale-shop__heading h3">{{ section.settings.heading | escape }}</h2>
    {% endif %}
    <ul class="lp-sale-shop__grid" role="list">
      {% for block in section.blocks %}
        {% liquid
          assign card_collection = block.settings.collection
          assign card_product = block.settings.product
          assign card_title = block.settings.title | default: card_collection.title | default: card_product.title
          assign card_url = block.settings.link | default: card_collection.url | default: card_product.url
          assign card_image = block.settings.image | default: card_product.featured_image | default: card_collection.featured_image
          assign image_loading = 'lazy'
          if section.index == 1 and forloop.index < 3
            assign image_loading = 'eager'
          endif
        %}
        <li class="lp-sale-shop__item" {{ block.shopify_attributes }}>
          {% if card_url != blank %}
            <a class="lp-sale-shop__card" href="{{ card_url }}">
          {% else %}
            <div class="lp-sale-shop__card">
          {% endif %}
            <div class="lp-sale-shop__media lp-sale-shop__media--{{ block.settings.image_fit }}">
              {% if card_image != blank %}
                {{ card_image | image_url: width: 1000 | image_tag: class: 'lp-sale-shop__image', widths: '240, 360, 480, 640, 800, 1000', sizes: '(min-width: 1100px) 25vw, (min-width: 750px) 50vw, 50vw', loading: image_loading, alt: '' }}
              {% else %}
                {{ 'product-1' | placeholder_svg_tag: 'lp-sale-shop__image' }}
              {% endif %}
            </div>
            <div class="lp-sale-shop__body">
              <h3 class="lp-sale-shop__title h4">{{ card_title | escape }}</h3>
              {% if block.settings.description != blank %}
                <p class="lp-sale-shop__description">{{ block.settings.description | escape }}</p>
              {% endif %}
              {% if card_url != blank %}
                <span class="lp-sale-shop__cta">
                  {{ block.settings.cta | escape }}
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" aria-hidden="true" focusable="false"><path d="M4 12h15m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
              {% endif %}
            </div>
          {% if card_url != blank %}
            </a>
          {% else %}
            </div>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  </div>
</div>

{% style %}
  .lp-sale-shop {
    padding-block: var(--lp-sale-top) var(--lp-sale-bottom);
  }
  .lp-sale-shop__inner {
    width: 100%;
  }
  .lp-sale-shop__heading {
    margin: 0 0 28px;
    text-wrap: balance;
  }
  .lp-sale-shop__grid {
    display: grid;
    grid-template-columns: repeat(var(--lp-sale-columns), minmax(0, 1fr));
    gap: 36px var(--lp-sale-gap);
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .lp-sale-shop__item {
    min-width: 0;
  }
  .lp-sale-shop__card {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: var(--color-foreground);
    text-decoration: none;
  }
  .lp-sale-shop__media {
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--color-background);
  }
  .lp-sale-shop__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .lp-sale-shop__media--contain .lp-sale-shop__image {
    object-fit: contain;
  }
  .lp-sale-shop__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding-top: 16px;
  }
  .lp-sale-shop__title {
    margin: 0;
    color: var(--color-foreground-heading);
    text-wrap: balance;
  }
  .lp-sale-shop__description {
    margin: 8px 0 16px;
    font-family: var(--font-paragraph--family);
    font-size: 0.9375rem;
    line-height: 1.5;
    text-wrap: pretty;
  }
  .lp-sale-shop__cta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding-top: 12px;
    margin-top: auto;
    border-top: 1px solid var(--color-foreground);
    font-size: 0.875rem;
    line-height: 1.4;
    font-weight: 600;
  }
  .lp-sale-shop__card:hover .lp-sale-shop__cta,
  .lp-sale-shop__card:focus-visible .lp-sale-shop__cta {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .lp-sale-shop__card:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 6px;
  }
  @media (max-width: 1099px) and (min-width: 750px) {
    .lp-sale-shop__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 749px) {
    .lp-sale-shop {
      padding-block: 32px 40px;
    }
    .lp-sale-shop__grid {
      grid-template-columns: repeat(var(--lp-sale-mobile-columns), minmax(0, 1fr));
      gap: 28px 16px;
    }
    .lp-sale-shop__heading {
      margin-bottom: 24px;
    }
    .lp-sale-shop__body {
      padding-top: 12px;
    }
    .lp-sale-shop__title {
      font-size: 1.25rem;
    }
    .lp-sale-shop__description {
      font-size: 0.8125rem;
    }
    .lp-sale-shop__cta {
      font-size: 0.8125rem;
      gap: 8px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Sale shopping links",
  "tag": "section",
  "class": "section-wrapper",
  "max_blocks": 16,
  "disabled_on": {"groups": ["header", "footer"]},
  "settings": [
    {"type": "text", "id": "heading", "label": "Heading", "default": "What's included"},
    {"type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1"},
    {"type": "range", "id": "columns", "label": "Desktop columns", "min": 2, "max": 4, "step": 1, "default": 4},
    {"type": "select", "id": "mobile_columns", "label": "Mobile columns", "options": [{"value": "1", "label": "1"}, {"value": "2", "label": "2"}], "default": "2"},
    {"type": "range", "id": "gap", "label": "Column gap", "min": 8, "max": 48, "step": 2, "unit": "px", "default": 24},
    {"type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48},
    {"type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 56}
  ],
  "blocks": [
    {
      "type": "shopping_link",
      "name": "Shopping link",
      "settings": [
        {"type": "text", "id": "title", "label": "Title"},
        {"type": "text", "id": "description", "label": "Description"},
        {"type": "collection", "id": "collection", "label": "Collection"},
        {"type": "product", "id": "product", "label": "Featured product", "info": "Used for the image. Also used for the link when no collection is selected."},
        {"type": "image_picker", "id": "image", "label": "Image override"},
        {"type": "select", "id": "image_fit", "label": "Image fit", "options": [{"value": "cover", "label": "Fill"}, {"value": "contain", "label": "Fit"}], "default": "cover"},
        {"type": "url", "id": "link", "label": "Link override"},
        {"type": "text", "id": "cta", "label": "Link label", "default": "Shop"}
      ]
    }
  ],
  "presets": [{"name": "Sale shopping links"}]
}
{% endschema %}
