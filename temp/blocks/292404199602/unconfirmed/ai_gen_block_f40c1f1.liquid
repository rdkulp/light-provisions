<script>
  (function() {
    class ScrollingImages{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.track = this.querySelector('[data-track]');
        if (!this.track) return;

        this.duplicateImages();
      }

      duplicateImages() {
        const items = Array.from(this.track.children);
        items.forEach(item => {
          const clone = item.cloneNode(true);
          this.track.appendChild(clone);
        });
      }
    }

    customElements.define('scrolling-images-{{ ai_gen_id }}', ScrollingImages{{ ai_gen_id }});
  })();
</script>

