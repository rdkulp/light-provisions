{% doc %}
  @prompt
    Create a custom Shopify section called **Scrolling Images**.
    
    
    Please include these settings:
    
    * **Images:** Add, remove, and reorder images. Allow an optional link for each image.
    * **Heading:** Editable text, font, font size, alignment, and color.
    * **Slider:** Adjustable scrolling speed, direction, gap between images, and pause-on-hover toggle.
    * **Image Size:** Separate width and height controls for desktop and mobile.
    * **Content Box:** Optional content box that can be enabled or disabled. Include controls for position, width, padding, background, and styling.
    * **Text:** Editable text inside the content box with font, size, alignment, and color controls.
    * **Layout:** Adjustable section padding, margins, and background color.
    
    Additional requirements:
    
    * Images should scroll continuously in a single horizontal row.
    * The animation should loop seamlessly without a noticeable jump.
    * Keep images side-by-side and never wrap into multiple rows.
    * Make the section fully responsive.
    * On mobile, preserve smooth scrolling and use the separate mobile image dimensions.
    * Use my existing theme styling and typography where possible.
    * Keep the section lightweight and avoid unnecessary features beyond the settings above.
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-scrolling-images-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding-top: {{ block.settings.padding_top }}px;
    padding-bottom: {{ block.settings.padding_bottom }}px;
    margin-top: {{ block.settings.margin_top }}px;
    margin-bottom: {{ block.settings.margin_bottom }}px;
    background-color: {{ block.settings.background_color }};
    overflow: hidden;
    position: relative;
  }

  .ai-scrolling-images-container-{{ ai_gen_id }} {
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-scrolling-images-heading-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    text-align: {{ block.settings.heading_alignment }};
    margin: 0 0 {{ block.settings.heading_bottom_margin }}px 0;
    padding: 0 20px;
  }

  .ai-scrolling-images-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .ai-scrolling-images-track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.image_gap }}px;
    width: max-content;
    animation: ai-scroll-{{ ai_gen_id }} {{ block.settings.scroll_speed }}s linear infinite;
    {% if block.settings.scroll_direction == 'right' %}
      animation-direction: reverse;
    {% endif %}
  }

  {% if block.settings.pause_on_hover %}
    .ai-scrolling-images-track-{{ ai_gen_id }}:hover {
      animation-play-state: paused;
    }
  {% endif %}

  .ai-scrolling-images-item-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.image_width_desktop }}px;
    height: {{ block.settings.image_height_desktop }}px;
  }

  .ai-scrolling-images-item-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-scrolling-images-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-scrolling-images-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-scrolling-images-content-box-{{ ai_gen_id }} {
    position: absolute;
    top: {{ block.settings.content_box_position_y }}%;
    left: {{ block.settings.content_box_position_x }}%;
    transform: translate(-50%, -50%);
    width: {{ block.settings.content_box_width }}%;
    max-width: 600px;
    padding: {{ block.settings.content_box_padding }}px;
    background-color: {{ block.settings.content_box_background }};
    border-radius: {{ block.settings.content_box_border_radius }}px;
    z-index: 10;
  }

  .ai-scrolling-images-content-text-{{ ai_gen_id }} {
    font-family: {{ block.settings.content_text_font.family }}, {{ block.settings.content_text_font.fallback_families }};
    font-weight: {{ block.settings.content_text_font.weight }};
    font-size: {{ block.settings.content_text_size }}px;
    color: {{ block.settings.content_text_color }};
    text-align: {{ block.settings.content_text_alignment }};
    margin: 0;
  }

  @keyframes ai-scroll-{{ ai_gen_id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-scrolling-images-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.7);
    }

    .ai-scrolling-images-item-{{ ai_gen_id }} {
      width: {{ block.settings.image_width_mobile }}px;
      height: {{ block.settings.image_height_mobile }}px;
    }

    .ai-scrolling-images-content-box-{{ ai_gen_id }} {
      width: {{ block.settings.content_box_width | times: 1.2 }}%;
      max-width: 90%;
      padding: {{ block.settings.content_box_padding | times: 0.7 }}px;
    }

    .ai-scrolling-images-content-text-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.content_text_size }}px * 0.85);
    }
  }
{% endstyle %}

