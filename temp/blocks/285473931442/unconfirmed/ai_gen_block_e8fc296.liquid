              </div>
              {% if block.settings.step_6_description != blank %}
                <div class="ai-process-story-step-description-{{ ai_gen_id }}">
                  {{ block.settings.step_6_description }}
                </div>
              {% endif %}
              {% if block.settings.step_6_image %}
                <div class="ai-process-story-step-image-{{ ai_gen_id }}">
                  <img
                    src="{{ block.settings.step_6_image | image_url: width: 800 }}"
                    alt="{{ block.settings.step_6_image.alt | escape }}"
                    loading="lazy"
                    width="{{ block.settings.step_6_image.width }}"
                    height="{{ block.settings.step_6_image.height }}"
                  >
                </div>
              {% endif %}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</process-story-{{ ai_gen_id }}>

<script>
  (function() {
    class ProcessStory{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        const video = this.querySelector('.ai-process-story-video-{{ ai_gen_id }}');
        if (video) {
          video.play().catch(() => {});
        }
      }
    }

    customElements.define('process-story-{{ ai_gen_id }}', ProcessStory{{ ai_gen_id }});
  })();
</script>

