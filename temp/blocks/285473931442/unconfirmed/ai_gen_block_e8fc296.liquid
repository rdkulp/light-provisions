                  {{ block.settings.step_4_description }}
                </div>
              {% endif %}
              {% if block.settings.step_4_image %}
                <div class="ai-process-story-step-image-{{ ai_gen_id }}">
                  <img
                    src="{{ block.settings.step_4_image | image_url: width: 800 }}"
                    alt="{{ block.settings.step_4_image.alt | escape }}"
                    loading="lazy"
                    width="{{ block.settings.step_4_image.width }}"
                    height="{{ block.settings.step_4_image.height }}"
                  >
                </div>
              {% endif %}
            </div>
          {% endif %}

          {% if block.settings.step_5_title != blank %}
            <div class="ai-process-story-step-{{ ai_gen_id }}">
              <div class="ai-process-story-step-header-{{ ai_gen_id }}">
                <span class="ai-process-story-step-number-{{ ai_gen_id }}">05</span>
                <h3 class="ai-process-story-step-title-{{ ai_gen_id }}">
                  {{ block.settings.step_5_title }}
                </h3>
              </div>
              {% if block.settings.step_5_description != blank %}
                <div class="ai-process-story-step-description-{{ ai_gen_id }}">
                  {{ block.settings.step_5_description }}
                </div>
              {% endif %}
              {% if block.settings.step_5_image %}
                <div class="ai-process-story-step-image-{{ ai_gen_id }}">
                  <img
                    src="{{ block.settings.step_5_image | image_url: width: 800 }}"
                    alt="{{ block.settings.step_5_image.alt | escape }}"
                    loading="lazy"
                    width="{{ block.settings.step_5_image.width }}"
                    height="{{ block.settings.step_5_image.height }}"
                  >
                </div>
              {% endif %}
            </div>
          {% endif %}

          {% if block.settings.step_6_title != blank %}
            <div class="ai-process-story-step-{{ ai_gen_id }}">
              <div class="ai-process-story-step-header-{{ ai_gen_id }}">
                <span class="ai-process-story-step-number-{{ ai_gen_id }}">06</span>
                <h3 class="ai-process-story-step-title-{{ ai_gen_id }}">
                  {{ block.settings.step_6_title }}
