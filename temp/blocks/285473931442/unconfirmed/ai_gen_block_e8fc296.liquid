{% doc %}
  @prompt
    Create a new Shopify section called "Process Story."
    
    The section should be designed specifically for vertical videos on desktop and mobile.
    
    Layout:
    
    * Two-column layout on desktop
    * Vertical video on the left (9:16 aspect ratio)
    * Heading, text, and process steps on the right
    * Stack vertically on mobile
    
    Content:
    
    * Section heading
    * Short introductory paragraph
    * Four process steps with optional image support
    * Each step should include a step number, title, and description
    
    Desktop layout example:
    
    [ Vertical Video ]   [ Heading ]
    [ Intro Text ]
    [ 01 Casting ]
    [ 02 Finishing ]
    [ 03 Assembly ]
    [ 04 Final Form ]
    
    Design requirements:
    
    * Minimal, editorial appearance consistent with a premium home goods brand
    * Generous whitespace
    * Rounded image corners
    * Optional color scheme support
    * Works with Shopify theme editor blocks
    * Each process step should be editable as a block
    * Video should remain sticky while scrolling through process steps on desktop
    * Mobile layout should place video above process steps
    
    Settings:
    
    * Video upload
    * Heading
    * Intro text
    * Background color
    * Text color
    * Up to 6 process step blocks
    * Optional process image for each step
    
    The purpose of this section is to tell the story behind handmade products and provide context around the making process rather than simply displaying a video.
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-process-story-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    padding: 80px 20px;
  }

  .ai-process-story-container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
  }

  .ai-process-story-layout-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 80px;
    align-items: start;
  }

  .ai-process-story-video-wrapper-{{ ai_gen_id }} {
    position: sticky;
    top: 100px;
    width: 100%;
  }

  .ai-process-story-video-container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 177.78%;
    background-color: #f4f4f4;
    border-radius: {{ block.settings.video_border_radius }}px;
    overflow: hidden;
  }

  .ai-process-story-video-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-process-story-video-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-process-story-video-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: auto;
    opacity: 0.3;
  }

  .ai-process-story-content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .ai-process-story-header-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .ai-process-story-heading-{{ ai_gen_id }} {
    font-size: 48px;
    line-height: 1.1;
    margin: 0;
    font-weight: 400;
    letter-spacing: -0.02em;
  }

  .ai-process-story-intro-{{ ai_gen_id }} {
    font-size: 18px;
    line-height: 1.6;
    opacity: 0.9;
    max-width: 600px;
  }

  .ai-process-story-steps-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 56px;
  }

  .ai-process-story-step-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ai-process-story-step-header-{{ ai_gen_id }} {
    display: flex;
    align-items: baseline;
    gap: 16px;
  }

  .ai-process-story-step-number-{{ ai_gen_id }} {
    font-size: 14px;
    font-weight: 500;
    opacity: 0.5;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    min-width: 40px;
  }

  .ai-process-story-step-title-{{ ai_gen_id }} {
    font-size: 24px;
    line-height: 1.3;
    margin: 0;
    font-weight: 400;
  }

  .ai-process-story-step-description-{{ ai_gen_id }} {
    font-size: 16px;
    line-height: 1.7;
    opacity: 0.85;
    margin-left: 56px;
  }

  .ai-process-story-step-image-{{ ai_gen_id }} {
    margin-left: 56px;
    margin-top: 16px;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
  }

  .ai-process-story-step-image-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
  }

  @media screen and (max-width: 989px) {
    .ai-process-story-{{ ai_gen_id }} {
      padding: 60px 20px;
    }

    .ai-process-story-layout-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .ai-process-story-video-wrapper-{{ ai_gen_id }} {
      position: relative;
      top: 0;
    }

    .ai-process-story-heading-{{ ai_gen_id }} {
      font-size: 36px;
    }

    .ai-process-story-intro-{{ ai_gen_id }} {
      font-size: 16px;
    }

    .ai-process-story-steps-{{ ai_gen_id }} {
      gap: 40px;
    }

    .ai-process-story-step-title-{{ ai_gen_id }} {
      font-size: 20px;
    }

    .ai-process-story-step-description-{{ ai_gen_id }} {
      margin-left: 0;
      font-size: 15px;
    }

    .ai-process-story-step-image-{{ ai_gen_id }} {
      margin-left: 0;
    }

    .ai-process-story-step-header-{{ ai_gen_id }} {
      flex-direction: column;
      gap: 8px;
    }

    .ai-process-story-step-number-{{ ai_gen_id }} {
      font-size: 12px;
    }
  }
{% endstyle %}

<process-story-{{ ai_gen_id }} class="ai-process-story-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-process-story-container-{{ ai_gen_id }}">
    <div class="ai-process-story-layout-{{ ai_gen_id }}">
      <div class="ai-process-story-video-wrapper-{{ ai_gen_id }}">
        <div class="ai-process-story-video-container-{{ ai_gen_id }}">
          {% if block.settings.video %}
            <video
              class="ai-process-story-video-{{ ai_gen_id }}"
              autoplay
              muted
              loop
              playsinline
            >
              <source src="{{ block.settings.video }}" type="video/mp4">
            </video>
          {% else %}
            <div class="ai-process-story-video-placeholder-{{ ai_gen_id }}">
              {{ 'hero-apparel-1' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
      </div>

      <div class="ai-process-story-content-{{ ai_gen_id }}">
        <div class="ai-process-story-header-{{ ai_gen_id }}">
          {% if block.settings.heading != blank %}
            <h2 class="ai-process-story-heading-{{ ai_gen_id }}">
              {{ block.settings.heading }}
            </h2>
          {% endif %}

          {% if block.settings.intro_text != blank %}
            <div class="ai-process-story-intro-{{ ai_gen_id }}">
              {{ block.settings.intro_text }}
            </div>
          {% endif %}
        </div>

        <div class="ai-process-story-steps-{{ ai_gen_id }}">
          {% if block.settings.step_1_title != blank %}
            <div class="ai-process-story-step-{{ ai_gen_id }}">
              <div class="ai-process-story-step-header-{{ ai_gen_id }}">
                <span class="ai-process-story-step-number-{{ ai_gen_id }}">01</span>
                <h3 class="ai-process-story-step-title-{{ ai_gen_id }}">
                  {{ block.settings.step_1_title }}
                </h3>
              </div>
              {% if block.settings.step_1_description != blank %}
                <div class="ai-process-story-step-description-{{ ai_gen_id }}">
                  {{ block.settings.step_1_description }}
                </div>
              {% endif %}
              {% if block.settings.step_1_image %}
                <div class="ai-process-story-step-image-{{ ai_gen_id }}">
                  <img
                    src="{{ block.settings.step_1_image | image_url: width: 800 }}"
                    alt="{{ block.settings.step_1_image.alt | escape }}"
                    loading="lazy"
                    width="{{ block.settings.step_1_image.width }}"
                    height="{{ block.settings.step_1_image.height }}"
                  >
                </div>
              {% endif %}
            </div>
          {% endif %}

          {% if block.settings.step_2_title != blank %}
            <div class="ai-process-story-step-{{ ai_gen_id }}">
              <div class="ai-process-story-step-header-{{ ai_gen_id }}">
                <span class="ai-process-story-step-number-{{ ai_gen_id }}">02</span>
                <h3 class="ai-process-story-step-title-{{ ai_gen_id }}">
                  {{ block.settings.step_2_title }}
                </h3>
              </div>
              {% if block.settings.step_2_description != blank %}
                <div class="ai-process-story-step-description-{{ ai_gen_id }}">
                  {{ block.settings.step_2_description }}
                </div>
              {% endif %}
              {% if block.settings.step_2_image %}
                <div class="ai-process-story-step-image-{{ ai_gen_id }}">
                  <img
                    src="{{ block.settings.step_2_image | image_url: width: 800 }}"
                    alt="{{ block.settings.step_2_image.alt | escape }}"
                    loading="lazy"
                    width="{{ block.settings.step_2_image.width }}"
                    height="{{ block.settings.step_2_image.height }}"
                  >
                </div>
              {% endif %}
            </div>
          {% endif %}

          {% if block.settings.step_3_title != blank %}
            <div class="ai-process-story-step-{{ ai_gen_id }}">
              <div class="ai-process-story-step-header-{{ ai_gen_id }}">
