{% doc %}
  @prompt
    Create a magazine-style founder profile section titled “Meet Brett.” Use an asymmetrical editorial layout with one large portrait image on the left and content on the right. Include a short introductory paragraph at the top, followed by six small customizable fact blocks arranged in a 2-column grid. Each fact block should have a small uppercase label and a short answer. Keep the design minimal and spacious with no cards, borders, shadows, icons, or buttons. Allow customizable background, heading, text, and accent colors. On mobile, stack the portrait above the text and fact blocks. The section should feel like an independent magazine founder profile rather than a standard image-with-text section.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-founder-profile-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px 20px;
  }

  .ai-founder-profile__container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-founder-profile__layout-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: {{ block.settings.content_gap }}px;
    align-items: start;
  }

  .ai-founder-profile__image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    position: relative;
  }

  .ai-founder-profile__image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-founder-profile__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 3 / 4;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-founder-profile__image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 400px;
  }

  .ai-founder-profile__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-founder-profile__content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.content_gap }}px;
  }

  .ai-founder-profile__header-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ai-founder-profile__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0;
    line-height: 1.2;
  }

  .ai-founder-profile__intro-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
    margin: 0;
  }

  .ai-founder-profile__facts-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: {{ block.settings.fact_gap }}px;
  }

  .ai-founder-profile__fact-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ai-founder-profile__fact-label-{{ ai_gen_id }} {
    font-size: {{ block.settings.label_size }}px;
    color: {{ block.settings.accent_color }};
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0;
    font-weight: 500;
  }

  .ai-founder-profile__fact-value-{{ ai_gen_id }} {
    font-size: {{ block.settings.fact_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
    line-height: 1.4;
  }

  @media screen and (max-width: 749px) {
    .ai-founder-profile__layout-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.mobile_gap }}px;
    }

    .ai-founder-profile__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.7 }}px;
    }

    .ai-founder-profile__intro-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.9 }}px;
    }

    .ai-founder-profile__facts-{{ ai_gen_id }} {
      gap: {{ block.settings.fact_gap | times: 0.8 }}px;
    }
  }
{% endstyle %}

<div class="ai-founder-profile-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-founder-profile__container-{{ ai_gen_id }}">
    <div class="ai-founder-profile__layout-{{ ai_gen_id }}">
      <div class="ai-founder-profile__image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.portrait_image %}
          <img
            src="{{ block.settings.portrait_image | image_url: width: 800 }}"
            alt="{{ block.settings.portrait_image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.portrait_image.width }}"
            height="{{ block.settings.portrait_image.height }}"
            class="ai-founder-profile__image-{{ ai_gen_id }}"
          >
        {% else %}
          <div class="ai-founder-profile__image-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
            <div class="ai-founder-profile__empty-state-{{ ai_gen_id }}">
              Add a portrait image
            </div>
          </div>
        {% endif %}
      </div>

      <div class="ai-founder-profile__content-{{ ai_gen_id }}">
        <div class="ai-founder-profile__header-{{ ai_gen_id }}">
          {% if block.settings.title != blank %}
            <h2 class="ai-founder-profile__title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
          {% endif %}

          {% if block.settings.intro_text != blank %}
            <div class="ai-founder-profile__intro-{{ ai_gen_id }}">
              {{ block.settings.intro_text }}
            </div>
          {% endif %}
        </div>

        <div class="ai-founder-profile__facts-{{ ai_gen_id }}">
          {% for i in (1..6) %}
            {% liquid
              assign label_key = 'fact_' | append: i | append: '_label'
              assign value_key = 'fact_' | append: i | append: '_value'
              assign label = block.settings[label_key]
              assign value = block.settings[value_key]
            %}

            {% if label != blank or value != blank %}
              <div class="ai-founder-profile__fact-{{ ai_gen_id }}">
                {% if label != blank %}
                  <div class="ai-founder-profile__fact-label-{{ ai_gen_id }}">{{ label }}</div>
                {% endif %}
                {% if value != blank %}
                  <div class="ai-founder-profile__fact-value-{{ ai_gen_id }}">{{ value }}</div>
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
